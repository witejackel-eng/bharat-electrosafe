# ────────────────────────────────────────────────────────────────
# Bharat Electrosafe — Environment Variables
# ────────────────────────────────────────────────────────────────
#
# Copy this file to .env.local and fill in the values.
# Production values belong in the Vercel dashboard, never in this file.
#
# Legend:
#   [PUBLIC]  — safe to expose in browser JavaScript (NEXT_PUBLIC_ prefix)
#   [SERVER]  — secret; must never appear in client bundles or browser output
#   [REQUIRED] — must be set for the application to work
#   [OPTIONAL] — application degrades gracefully when unset

# ── PUBLIC (non-sensitive) ──────────────────────────────────────

# NEXT_PUBLIC_SITE_URL [PUBLIC] [REQUIRED]
# The canonical domain of the public-facing website.
# Must be the permanent production domain in production.
# Preview and local deployments may use a different URL, but canonical URLs,
# sitemap entries, robots.txt, Open Graph and JSON-LD all resolve against
# this value when indexing is enabled.
NEXT_PUBLIC_SITE_URL=https://bharatelectrosafe.com

# NEXT_PUBLIC_ALLOW_INDEXING [PUBLIC] [REQUIRED]
# Set true only in the Vercel Production environment after the official
# domain serves this new website. Keep false for Preview and Development.
# Even when set to true, indexing is also gated by the site URL matching
# https://bharatelectrosafe.com exactly AND VERCEL_ENV being 'production'.
NEXT_PUBLIC_ALLOW_INDEXING=false

# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION [PUBLIC] [OPTIONAL]
# Google Search Console verification token. Only output when a real value
# exists. Do not commit a real verification token — add it in the Vercel
# dashboard when ready. Leave empty until the production domain is verified.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── SERVER (secrets — never use NEXT_PUBLIC_ prefix) ────────────

# RESEND_API_KEY [SERVER] [REQUIRED]
# API key for the Resend email delivery service.
# Must be set in the Vercel dashboard. Never commit a real key.
# Format: re_xxxxxxxxxxxx
RESEND_API_KEY=

# CONTACT_FROM_EMAIL [SERVER] [REQUIRED]
# Sender email address for contact-form enquiries.
# Must be a domain verified with Resend.
# Format: enquiries@your-verified-domain.com
CONTACT_FROM_EMAIL=

# CONTACT_TO_EMAIL [SERVER] [OPTIONAL]
# Recipient email address for contact-form enquiries.
# Defaults to the company email if not set.
# Format: recipient@company.com
CONTACT_TO_EMAIL=

# ── DEVELOPMENT ONLY ────────────────────────────────────────────

# DATABASE_URL [SERVER] [OPTIONAL]
# Local SQLite database URL for development tooling only.
# Not used by the production application.
# DATABASE_URL=file:./dev.db

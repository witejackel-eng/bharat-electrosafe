# Copy to .env.local and fill in. Never commit a filled-in copy —
# .env* is gitignored.

# ── Enquiry delivery (Resend) ──
# Without RESEND_API_KEY and CONTACT_FROM_EMAIL the contact form returns a
# 503 and shows the direct phone/email/WhatsApp details instead. It never
# reports success for an enquiry it could not deliver.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
# Do not launch on onboarding@resend.dev.
CONTACT_FROM_EMAIL=Bharat Electrosafe Website <website@bharatelectrosafe.com>
# Where enquiries are delivered. Defaults to info@bharatelectrosafe.com.
CONTACT_TO_EMAIL=info@bharatelectrosafe.com

# ── Rate limiting (optional) ──
# Without these the API falls back to an in-process limiter, which on
# serverless is per-instance and therefore only best-effort.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Search engine indexing ──
# Keep false until the custom domain is live and the client has approved
# launch. Controls robots.txt and the robots meta tag.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ────────────────────────────────────────────────────────────────
# Bharat Electrosafe — Environment Variables
# ────────────────────────────────────────────────────────────────
#
# Copy this file to .env.local and fill in the values.
# Production values belong in the Vercel dashboard, never in this file.
#
# Legend:
#   [PUBLIC]  — safe to expose in browser JavaScript (NEXT_PUBLIC_ prefix)
#   [SERVER]  — secret; must never appear in client bundles or browser output
#   [REQUIRED] — must be set for the application to work
#   [OPTIONAL] — application degrades gracefully when unset

# ── PUBLIC (non-sensitive) ──────────────────────────────────────

# NEXT_PUBLIC_SITE_URL [PUBLIC] [REQUIRED]
# The canonical domain of the public-facing website.
# Must be the permanent production domain in production.
# Preview and local deployments may use a different URL, but canonical URLs,
# sitemap entries, robots.txt, Open Graph and JSON-LD all resolve against
# this value when indexing is enabled.
NEXT_PUBLIC_SITE_URL=https://bharatelectrosafe.com

# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION [PUBLIC] [OPTIONAL]
# Google Search Console verification token. Only output when a real value
# exists. Do not commit a real verification token — add it in the Vercel
# dashboard when ready. Leave empty until the production domain is verified.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# NEXT_PUBLIC_TURNSTILE_SITE_KEY [PUBLIC] [OPTIONAL]
# Cloudflare Turnstile site key for client-side widget rendering.
# Required only if TURNSTILE_SECRET_KEY is set. Turnstile provides
# invisible bot protection on the contact form without visual CAPTCHA.
# Obtain from: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── SERVER (secrets — never use NEXT_PUBLIC_ prefix) ────────────

# ALLOW_INDEXING [SERVER] [REQUIRED]
# Set to true ONLY in the Vercel Production environment after the official
# domain serves this website and has been verified. Keep false (or unset)
# for Preview and Development environments.
# Even when set to true, indexing is also gated by VERCEL_ENV being
# 'production' — preview deployments are never indexable.
# Backwards compatible: if unset, falls back to NEXT_PUBLIC_ALLOW_INDEXING.
ALLOW_INDEXING=false

# NEXT_PUBLIC_ALLOW_INDEXING [PUBLIC] [DEPRECATED]
# Legacy indexing flag — prefer ALLOW_INDEXING (server-only) instead.
# If ALLOW_INDEXING is set, this value is ignored. Kept for backwards
# compatibility with existing Vercel deployments.
NEXT_PUBLIC_ALLOW_INDEXING=false

# RESEND_API_KEY [SERVER] [REQUIRED]
# API key for the Resend email delivery service.
# Must be set in the Vercel dashboard. Never commit a real key.
# Format: re_xxxxxxxxxxxx
RESEND_API_KEY=

# CONTACT_FROM_EMAIL [SERVER] [REQUIRED]
# Sender email address for contact-form enquiries.
# Must be a domain verified with Resend.
# Format: enquiries@your-verified-domain.com
CONTACT_FROM_EMAIL=

# CONTACT_TO_EMAIL [SERVER] [OPTIONAL]
# Recipient email address for contact-form enquiries.
# Defaults to the company email if not set.
# Format: recipient@company.com
CONTACT_TO_EMAIL=

# UPSTASH_REDIS_REST_URL [SERVER] [OPTIONAL]
# Upstash Redis REST API URL for distributed rate limiting.
# Without this, rate limiting falls back to per-instance in-memory
# tracking (less effective on serverless but still provides protection).
# Required for production-quality rate limiting across serverless instances.
# Obtain from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=

# UPSTASH_REDIS_REST_TOKEN [SERVER] [OPTIONAL]
# Upstash Redis REST API token. Must be set if UPSTASH_REDIS_REST_URL is set.
UPSTASH_REDIS_REST_TOKEN=

# TURNSTILE_SECRET_KEY [SERVER] [OPTIONAL]
# Cloudflare Turnstile secret key for server-side token verification.
# If not set, Turnstile verification is skipped gracefully (other
# protections — honeypot, timing, rate limit — remain active).
# Never commit this value. Obtain from the Turnstile dashboard.
TURNSTILE_SECRET_KEY=

# ── DEVELOPMENT ONLY ────────────────────────────────────────────

# DATABASE_URL [SERVER] [OPTIONAL]
# Local SQLite database URL for development tooling only.
# Not used by the production application.
# DATABASE_URL=file:./dev.db

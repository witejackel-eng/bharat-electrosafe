{
  "$schema": "https://raw.githubusercontent.com/GoogleChrome/lighthouse-ci/main/schema.json",
  "ci": {
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "uses-text-compression": "off",
        "uses-responsive-images": "off",
        "csp-xss": "off"
      }
    },
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/products",
        "http://localhost:3000/products/electrical-insulating-mats",
        "http://localhost:3000/products/bharat-membrane",
        "http://localhost:3000/products/bharat-hydro-seal",
        "http://localhost:3000/about-us",
        "http://localhost:3000/contact-us"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        }
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
